{
  "id": "example",
  "template": true,
  "sites": [
    {
      "id": "example",
      "name": "Example gallery",
      "base_url": "https://example.com",
      "default_gallery_url": "https://example.com",
      "media_cdn_host": "https://cdn.example.com",
      "tag_fetch_order": [
        "curl_cffi",
        "httpx",
        "curl",
        "playwright_api",
        "html"
      ],
      "extension": {
        "page_matches": [
          "https://example.com/*",
          "https://cdn.example.com/*"
        ],
        "post_id_patterns": [
          "^https?://example\\.com/post/(\\d+)",
          "^https?://cdn\\.example\\.com/posts/\\d+/(\\d+)/"
        ],
        "post_url_template": "https://example.com/post/{id}"
      }
    }
  ],
  "scrapers": [
    {
      "id": "example_default",
      "name": "Default",
      "description": "Sample scraper entry — change id/name/site_ids to match your package",
      "site_ids": ["example"]
    }
  ]
}
