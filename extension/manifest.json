{
  "manifest_version": 3,
  "name": "MediaViewer",
  "version": "0.1.5",
  "description": "Send the current page to your local MediaViewer app.",
  "permissions": ["storage", "contextMenus", "tabs", "scripting", "activeTab", "alarms"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "MediaViewer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/red16.png",
      "32": "icons/red32.png",
      "48": "icons/red48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
